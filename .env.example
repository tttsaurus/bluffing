# Local PostgreSQL, or Neon's pooled URL from the Vercel Marketplace integration.
DATABASE_URL=postgresql://blufftable:blufftable@127.0.0.1:5432/blufftable
# Neon: direct/unpooled URL for migrations and backups. Optional for local PG.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
PORT=8080
# Implicit root is restricted to direct loopback requests and always disabled on Vercel.
ALLOW_LOCAL_ROOT=true
