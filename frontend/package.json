{
  "name": "bluff-table-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tailnet": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "npm run test:store && npm run test:unit",
    "test:store": "node tests/store.test.mjs",
    "test:unit": "vitest run",
    "test:coverage": "npm run test:store && vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
